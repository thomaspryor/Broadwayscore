#!/bin/bash
# Pre-push hook (version-controlled — points here via core.hooksPath).
#
# Two responsibilities:
#   1. CLAUDE.md critical-section protection: catch concurrent sessions
#      that silently revert protected sections of the repo's project
#      instructions. (Original 2026-03-27 implementation.)
#   2. CI lint gates running locally so violations don't burn a CI cycle:
#      - audit-tests-vs-derived-data.js
#      - audit-playwright-evaluate-click.js
#      - audit-orphan-tests.js
#
# Install (one-time, per clone):
#   ./scripts/setup-git-hooks.sh
# Or directly:
#   git config --local core.hooksPath scripts/hooks
#
# Bypass for genuine emergencies:
#   git push --no-verify
# Don't make a habit of it — the gates exist because the bugs they catch
# all shipped at least once.

set -uo pipefail

# Read stdin ONCE into an array — git invokes pre-push with push specs on
# stdin and you only get to consume them once. Two separate `while read`
# loops would silently make the second one a no-op (first attempt at this
# hook had exactly that bug — 2026-05-26).
PUSH_SPECS=()
while read line; do
  PUSH_SPECS+=("$line")
done

CRITICAL_PATTERNS=(
  "Notion Brain"
  "Test Extraction Pattern"
  "Email Broadcast Safety"
  "Opening Night Readiness"
)

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Aggregate all changed paths across the push range, plus run the
# CLAUDE.md guard in the same pass. Track whether ANY spec is a real
# (non-deletion) push — if every spec is a delete, skip audits entirely.
ALL_CHANGED_FILES=""
HAVE_NON_DELETE_SPEC=0

for spec in "${PUSH_SPECS[@]}"; do
  read local_ref local_oid remote_ref remote_oid <<<"$spec"
  # Skip deletions (local_oid is all zeros for `git push --delete`)
  [ "$local_oid" = "0000000000000000000000000000000000000000" ] && continue
  HAVE_NON_DELETE_SPEC=1

  if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
    # New branch — diff against the merge-base with origin/main if possible.
    base=$(git merge-base "$local_oid" origin/main 2>/dev/null || true)
    if [ -n "$base" ]; then
      range_files=$(git diff --name-only "$base..$local_oid" 2>/dev/null || true)
    else
      # No upstream we can compare against — fall back to listing this commit's tree
      range_files=$(git show --name-only --pretty=format: "$local_oid" 2>/dev/null || true)
    fi
  else
    range_files=$(git diff --name-only "$remote_oid..$local_oid" 2>/dev/null || true)
  fi
  ALL_CHANGED_FILES="$ALL_CHANGED_FILES
$range_files"

  # CLAUDE.md guard (only meaningful when there's a remote_oid to compare).
  if [ "$remote_oid" != "0000000000000000000000000000000000000000" ] && \
     echo "$range_files" | grep -q "^CLAUDE.md$"; then
    remote_content=$(git show "$remote_oid:CLAUDE.md" 2>/dev/null)
    local_content=$(git show "$local_oid:CLAUDE.md" 2>/dev/null)
    if [ -n "$remote_content" ]; then
      for pattern in "${CRITICAL_PATTERNS[@]}"; do
        if echo "$remote_content" | grep -q "$pattern" && \
           ! echo "$local_content" | grep -q "$pattern"; then
          echo ""
          echo "=== PRE-PUSH BLOCKED: CLAUDE.md section reverted ==="
          echo ""
          echo "  The remote CLAUDE.md contains '$pattern'"
          echo "  but your version removes it. Concurrent session conflict?"
          echo "  Pull, re-apply, ensure both sections are present."
          echo ""
          echo "  Inspect: git diff $remote_oid..$local_oid -- CLAUDE.md"
          echo ""
          exit 1
        fi
      done
    fi
  fi
done

run_audit() {
  local label="$1"
  local script="$2"
  if ! node "$script" >/tmp/pre-push-audit.out 2>&1; then
    echo ""
    echo "=== PRE-PUSH BLOCKED: $label failed ==="
    echo ""
    cat /tmp/pre-push-audit.out
    echo ""
    echo "(Bypass for emergencies: git push --no-verify)"
    rm -f /tmp/pre-push-audit.out
    exit 1
  fi
  rm -f /tmp/pre-push-audit.out
}

# Pure-deletion push (every spec was a delete) — nothing to audit.
if [ "$HAVE_NON_DELETE_SPEC" = "0" ]; then
  exit 0
fi

# Non-delete specs exist but we couldn't determine the file list (rare:
# truly first push, no upstream to diff against). Run all audits as a
# safe default rather than skipping.
if [ -z "$(echo "$ALL_CHANGED_FILES" | tr -d '[:space:]')" ]; then
  run_audit "tests-vs-derived-data" "scripts/audit-tests-vs-derived-data.js"
  run_audit "orphan-tests" "scripts/audit-orphan-tests.js"
  run_audit "playwright-evaluate-click" "scripts/audit-playwright-evaluate-click.js"
  exit 0
fi

# Range-scoped: only run the audit when its target paths changed.
if echo "$ALL_CHANGED_FILES" | grep -qE "^tests/unit/.*\.test\.(mjs|ts|js)$|^\.github/workflows/test\.yml$|^scripts/audit-(tests-vs-derived-data|orphan-tests)\.js$"; then
  run_audit "tests-vs-derived-data" "scripts/audit-tests-vs-derived-data.js"
  run_audit "orphan-tests" "scripts/audit-orphan-tests.js"
fi

if echo "$ALL_CHANGED_FILES" | grep -qE "^tests/e2e/.*\.(ts|tsx|mjs|js)$|^scripts/audit-playwright-evaluate-click\.js$"; then
  run_audit "playwright-evaluate-click" "scripts/audit-playwright-evaluate-click.js"
fi

# TypeScript typecheck — the one diff-local code-correctness gate worth running
# on push. Runs only when this push touches .ts/.tsx. tsc is project-wide (types
# interconnect, so it can't be scoped to changed files), but CI keeps main green,
# so a local failure almost always means THIS change broke types — catch it
# before it lands on the ungated trunk (direct-push to main has no required
# checks) instead of burning a CI cycle and reddening main for everyone.
#
# DATA GUARD: src/lib/data-*.ts import the gitignored data JSON as modules
# (`import reviews from '../../data/reviews.json'`). A bare worktree doesn't have
# those files (they're symlinked only in the primary checkout / fetched in CI),
# so tsc would fail with TS2307 module-not-found for reasons unrelated to the
# push — a false-block on the worktree workflow this repo runs on. So we run tsc
# ONLY when the data is actually present: it gates real type errors from
# data-equipped checkouts and safely no-ops in bare worktrees (never false-block).
#
# Deliberately NOT added here: `next lint` and the ~240-file no-data unit-test
# batch. Both are whole-project gates that would block EVERY session's push the
# moment main has any pre-existing lint/test failure (the same shared-red problem
# as the corpus gates, just for code) and are slow enough (~1-2 min) to drive a
# `--no-verify` habit that defeats the hook. tsc is the sweet spot: ~30-60s,
# exit-code-clean, and near-zero false-blocks because CI already keeps main green.
if echo "$ALL_CHANGED_FILES" | grep -qE "\.(ts|tsx)$"; then
  if [ -f data/reviews.json ] && [ -f data/shows.json ]; then
    echo "pre-push: tsc --noEmit (push touches TypeScript)…"
    if ! npx tsc --noEmit >/tmp/pre-push-tsc.out 2>&1; then
      echo ""
      echo "=== PRE-PUSH BLOCKED: tsc --noEmit failed ==="
      echo ""
      cat /tmp/pre-push-tsc.out
      echo ""
      echo "(Bypass for emergencies: git push --no-verify)"
      rm -f /tmp/pre-push-tsc.out
      exit 1
    fi
    rm -f /tmp/pre-push-tsc.out
  else
    echo "pre-push: skipping tsc (data/*.json absent — bare worktree; tsc needs them)"
  fi
fi

exit 0
