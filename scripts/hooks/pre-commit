#!/usr/bin/env bash
# Pre-commit hook (version-controlled — active via core.hooksPath=scripts/hooks
# or via the delegator in .git/hooks/pre-commit).
#
# 1. Reject tracked symlinks and gitlinks.
#    Symlinks (120000) dangle in CI; gitlinks (160000) cause submodule errors.
#    Three incidents: data/reviews.json, .core-data-checkout,
#    .claude/worktrees/fix-ci-noise. See commit 16f700b3b5 and the CI lint in test.yml.
# 2. Reject staged poster/thumbnail/hero images with wrong aspect ratio
#    (evita-west-end-2025 landscape-poster incident, commit a71c3defe4).

BAD=$(git diff --cached --diff-filter=A --raw | grep -E "^:000000 (120000|160000)" | awk '{print $6}')

if [ -n "$BAD" ]; then
  echo "ERROR: Refusing to commit symlinks or gitlinks:"
  echo "$BAD"
  echo ""
  echo "Symlinks (120000) become dangling in CI — cp -f refuses to write through them."
  echo "Gitlinks (160000) cause 'No url found for submodule path' errors."
  echo "Fix: git reset HEAD <path> and add to .gitignore if needed."
  exit 1
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
if [ -f "$REPO_ROOT/scripts/check-image-aspect.js" ]; then
  node "$REPO_ROOT/scripts/check-image-aspect.js" --staged
  RC=$?
  if [ $RC -ne 0 ]; then
    exit $RC
  fi
fi

# 3. Auto-sort staged test manifests (tests/unit-test-manifest.txt and its
#    -tsx/e2e siblings). tests/unit/test-manifest-integrity.test.mjs requires
#    these sorted so concurrent sessions appending new entries land at
#    different lines instead of all colliding on the same last line (card
#    #763). The CI check alone only catches an unsorted manifest AFTER a
#    commit lands — 3+ independent 'fix: re-sort tests/unit-test-manifest.txt'
#    commits happened anyway because sessions append faster than anyone can
#    hand-fix it (card #1825). Sorting here, before the commit is made, means
#    the unsorted state never reaches CI. Re-stages only manifests that were
#    already staged — an unstaged, only-on-disk manifest edit is left alone.
STAGED_MANIFESTS=$(git diff --cached --name-only --diff-filter=ACM | grep -E "^tests/(unit-test-manifest(-tsx)?|e2e-unit-test-manifest)\.txt$" || true)
if [ -n "$STAGED_MANIFESTS" ] && [ -f "$REPO_ROOT/scripts/lib/test-manifest.js" ]; then
  node "$REPO_ROOT/scripts/lib/test-manifest.js" --fix
  while IFS= read -r manifest; do
    [ -n "$manifest" ] && git add "$REPO_ROOT/$manifest"
  done <<<"$STAGED_MANIFESTS"
fi

# 4. Block commits that introduce new secrets (gitleaks, staged diff only ~1s).
#    Lives HERE rather than in a separate hook file because core.hooksPath is set
#    to scripts/hooks — git then ignores .git/hooks/ entirely, so a hook installed
#    there would be copied successfully and never run. Silent no-op.
#    Added 2026-07-26 after a live BUFFER_TOKEN sat in this public repo ~4 months.
if command -v gitleaks >/dev/null 2>&1; then
  GITLEAKS_CONFIG_ARG=()
  if [ -f "$REPO_ROOT/.gitleaks.toml" ]; then
    GITLEAKS_CONFIG_ARG=(--config "$REPO_ROOT/.gitleaks.toml")
  fi
  if ! gitleaks protect --staged --no-banner --redact "${GITLEAKS_CONFIG_ARG[@]}"; then
    echo "" >&2
    echo "❌ gitleaks found a potential secret in staged changes." >&2
    echo "" >&2
    echo "Options:" >&2
    echo "  1. Remove the secret. (Preferred.)" >&2
    echo "  2. If it's a verified false positive, add an entry to .gitleaks.toml" >&2
    echo "     [allowlist] regexes/paths and re-stage." >&2
    echo "  3. Emergency bypass: git commit --no-verify" >&2
    echo "" >&2
    exit 1
  fi
else
  echo "⚠️  gitleaks not installed — skipping secret scan (brew install gitleaks)." >&2
fi
