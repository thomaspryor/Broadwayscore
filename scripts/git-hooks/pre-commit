#!/usr/bin/env bash
# Pre-commit hook: block commits that introduce new secrets.
#
# Scans only the staged diff (not full history) so it's fast (~1s).
# Use the allowlist in .gitleaks.toml for known-FP patterns and dead-leak commits.
#
# Install: bash scripts/install-git-hooks.sh
# Bypass once (emergency only): git commit --no-verify

set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "⚠️  gitleaks not installed — skipping secret scan." >&2
  echo "   Install: brew install gitleaks" >&2
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
CONFIG="${REPO_ROOT}/.gitleaks.toml"

CONFIG_ARG=()
if [ -f "$CONFIG" ]; then
  CONFIG_ARG=(--config "$CONFIG")
fi

if ! gitleaks protect --staged --no-banner "${CONFIG_ARG[@]}"; then
  echo "" >&2
  echo "❌ gitleaks found a potential secret in staged changes." >&2
  echo "" >&2
  echo "Options:" >&2
  echo "  1. Remove the secret. (Preferred.)" >&2
  echo "  2. If it's a verified false positive, add an entry to .gitleaks.toml" >&2
  echo "     [allowlist] regexes/paths and re-stage." >&2
  echo "  3. Emergency bypass: git commit --no-verify" >&2
  echo "" >&2
  exit 1
fi
