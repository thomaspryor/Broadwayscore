<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- BRO-2719: Mac-local worktree-gc.log freshness deadman (the log is gitignored, so CI cannot see it). Daily 09:05 local. Install: cp scripts/launchd/com.broadwayscore.worktree-gc-freshness.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.broadwayscore.worktree-gc-freshness.plist -->
    <key>Label</key>
    <string>com.broadwayscore.worktree-gc-freshness</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/tompryor/Broadwayscore &amp;&amp; exec node scripts/check-worktree-gc-freshness.js</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/worktree-gc-freshness-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/worktree-gc-freshness-launchd.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/tompryor/.local/bin</string>
    </dict>
</dict>
</plist>
