<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- BRO-8175: per-job worker memory cap, every 60s, outside cmux.
     A runaway headless worker grew ~1 GB/min on 2026-11-23 and stalled the
     Mac. The in-runner sampler (claude-cli.js) dies with its runner and the
     dashboard sweep dies with cmux; this tick runs only the memory-cap pass
     (no plan/sweep/health) and kills a job tree after 2 over-cap passes at
     least 30s apart, so worst case ~2 min after crossing the cap.
     Install: cp scripts/launchd/com.broadwayscore.job-memory-cap.plist ~/Library/LaunchAgents/
              launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.broadwayscore.job-memory-cap.plist
     Liveness: dispatch-watchdog.js --health pages when
     data/audit/job-memory-cap-state.json is older than 5 min. -->
<dict>
  <key>Label</key>
  <string>com.broadwayscore.job-memory-cap</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/tompryor/Broadwayscore/scripts/dispatch-watchdog.js</string>
    <string>--memory-cap</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/Users/tompryor/Library/Logs/job-memory-cap.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/tompryor/Library/Logs/job-memory-cap.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
