<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Automatic cookie renewal for thestage, nytimes, newyorker, wapo,
         thetimes, ft, telegraph (BRO-4183, BRO-7705).

         Every 6h: scripts/renew-cookies.js checks each outlet's walled
         article (plain HTTPS for thestage/nytimes/wapo; inside the outlet's
         persistent Chrome profile for newyorker/thetimes/ft/telegraph, always
         against a no-session control). Logged in and no auth cookie lapsing
         within 3 days: nothing happens. Otherwise it takes the profile's own
         session, or adopts the saved cookies into the profile, and only then
         logs in ONCE (password or Gmail one-time code, credentials from the
         macOS Keychain). Renewed cookies are pushed to COOKIES_BUNDLE_* once
         per run via extract-safari-cookies.py (from-local mode) and confirmed
         with a live check-cookie-health run. Missing Keychain items, CAPTCHA,
         emailed code, rejected password, or 2 logins in 7 days: stops, emails
         one link, and stays stopped (see the renew-cookies.js header for the
         manual and reset flags). Bot challenges never trigger a login.

         MAC STUDIO ONLY. Never add these logins to CI or cloud: per-runner
         logins tripped The Stage's 2-device limit on 2026-03-30.

         Keychain items (service broadwayscorecard-cookie-renew), one pair per
         outlet, account names <outlet>-email and <outlet>-password; nytimes and
         newyorker need only the email (exact commands: scripts/lib/cookie-renew.js
         readKeychain docstring). A missing-Keychain stop clears itself on the
         next run after the items are added.

         .env is sourced for RESEND_API_KEY/OWNER_EMAIL (alert email) only;
         launchd does not inherit shell env. `gh` must be authenticated with
         secrets:write on thomaspryor/Broadwayscore. The first Keychain read
         from launchd may show an "allow access" prompt: choose Always Allow.

         Install:  cp scripts/launchd/com.broadwayscore.cookie-renew.plist ~/Library/LaunchAgents/
                   launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.broadwayscore.cookie-renew.plist
         Manual run: launchctl kickstart -k gui/$(id -u)/com.broadwayscore.cookie-renew
         Kill:     launchctl bootout gui/$(id -u)/com.broadwayscore.cookie-renew -->
    <key>Label</key>
    <string>com.broadwayscore.cookie-renew</string>
    <!-- Both flags on purpose: renew-cookies.js reads outlets= first (all
         outlets); a main checkout still on the pre-BRO-7705 script reads only
         outlet= and keeps renewing The Stage instead of exiting on an unknown
         flag (checkout-sync can lag main for hours). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd /Users/tompryor/Broadwayscore &amp;&amp; set -a &amp;&amp; source .env &amp;&amp; set +a &amp;&amp; exec node scripts/renew-cookies.js --outlets=all --outlet=thestage</string>
    </array>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>StandardOutPath</key>
    <string>/tmp/cookie-renew.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/cookie-renew.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
