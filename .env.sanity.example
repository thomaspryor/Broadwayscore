# Sanity Blog CMS — copy these into .env.local (local dev) and Vercel env vars (prod).
# Get values from https://www.sanity.io/manage after creating a project.

NEXT_PUBLIC_SANITY_PROJECT_ID=   # e.g. "abc12345" (from sanity.io/manage)
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-side read token (NOT exposed to browser). Required for dataset reads.
# Create a Viewer-role token at sanity.io/manage → API → Tokens.
SANITY_API_READ_TOKEN=

# Switch /reviews source from content/reviews/*.md (legacy) to Sanity (after migration).
USE_SANITY_REVIEWS=false
