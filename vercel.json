{
  "functions": {
    "api/approve-fix.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/biz-buzz",
      "destination": "/biz",
      "permanent": true
    },
    {
      "source": "/browse/best-broadway-musicals",
      "destination": "/guides/best-broadway-musicals",
      "permanent": true
    },
    {
      "source": "/browse/best-broadway-plays",
      "destination": "/guides/best-broadway-plays",
      "permanent": true
    },
    {
      "source": "/browse/broadway-shows-closing-soon",
      "destination": "/guides/broadway-shows-closing-soon",
      "permanent": true
    },
    {
      "source": "/browse/broadway-shows-for-kids",
      "destination": "/guides/best-broadway-shows-for-kids",
      "permanent": true
    },
    {
      "source": "/west-end/best",
      "destination": "/browse/west-end-shows",
      "permanent": true
    },
    {
      "source": "/director/:path*",
      "destination": "/creative/:path*",
      "permanent": true
    },
    {
      "source": "/directors/:slug",
      "destination": "/creative/:slug",
      "permanent": true
    },
    {
      "source": "/playwrights/:slug",
      "destination": "/creative/:slug",
      "permanent": true
    },
    {
      "source": "/composers/:slug",
      "destination": "/creative/:slug",
      "permanent": true
    },
    {
      "source": "/lyricists/:slug",
      "destination": "/creative/:slug",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.broadwayscorecard.com"
        }
      ],
      "destination": "https://broadwayscorecard.com/$1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "westendscorecard.com"
        }
      ],
      "destination": "https://broadwayscorecard.com/west-end",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "westendscorecard.com"
        }
      ],
      "destination": "https://broadwayscorecard.com/:path+",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.westendscorecard.com"
        }
      ],
      "destination": "https://broadwayscorecard.com/west-end",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.westendscorecard.com"
        }
      ],
      "destination": "https://broadwayscorecard.com/:path+",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "offbroadwayscorecard.com"
        }
      ],
      "destination": "https://broadwayscorecard.com/off-broadway",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "offbroadwayscorecard.com"
        }
      ],
      "destination": "https://broadwayscorecard.com/:path+",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.offbroadwayscorecard.com"
        }
      ],
      "destination": "https://broadwayscorecard.com/off-broadway",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.offbroadwayscorecard.com"
        }
      ],
      "destination": "https://broadwayscorecard.com/:path+",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
