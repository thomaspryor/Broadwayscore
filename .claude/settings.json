{
  "_comment": "Project-scoped Claude Code config. Loaded by cloud apps (iOS, Mac, web) that can't reach the user's ~/.claude/. Each project hook script begins with a self-skip preamble: if ~/.claude/hooks/<basename> exists (local CLI), the project copy exits 0 and the user-level master fires. On cloud sandboxes ~/.claude/hooks/ does not exist, so the project copy runs. See .claude/CLOUD.md.",
  "_comment_permissions": "Server-level MCP allow: 'mcp__<server>' pre-approves ALL tools from that server (per docs.claude.com permissions ref), so cloud sessions can self-schedule PR/CI check-ins (send_later/create_trigger) without an approval wall — no need to enumerate or verify individual tool ids. If the connector's server name differs from 'claude-code-remote', update the string below. Harmless on local CLI where the server isn't connected.",
  "permissions": {
    "allow": [
      "mcp__claude-code-remote"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/notion-create-block.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/worktree-enforce.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-push-visual-gate.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-push-review-gate.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-skill-redaction.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-merge-review-gate.sh"
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/enterworktree-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/whitespace-nowrap-lint.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/cloud-bootstrap.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/verify-edits.sh"
          }
        ]
      }
    ]
  }
}
