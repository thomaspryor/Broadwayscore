{"_v":3,"id":"city-of-angels-1989","cat":"broadway","bd":{"positive":1,"mixed":0,"negative":0},"rv":[{"cn":"Unknown","o":"The New York Times","s":94,"b":"Rave","t":1,"u":"https://www.nytimes.com/1989/12/12/theater/review-theater-40-s-hollywood-doubly-mocked-in-gelbart-s-city-of-angels.html","d":"1989-12-12","q":"This is an evening in which even a throwaway wisecrack spreads laughter like wildfire through the house, until finally the roars from the balcony merge with those from the orchestra and the pandemonium takes on a life of its own."}],"au":{"score":81,"designation":"Liking","sources":{"mz":{"s":81,"c":8,"sr":4.1},"rd":{"s":79,"c":36,"tp":47,"sent":{"enthusiastic":0.17,"positive":0.44,"mixed":0.14,"negative":0.17,"neutral":0.08}}}},"tn":[{"yr":44,"cat":"Best Musical","n":null,"w":true},{"yr":44,"cat":"Best Book of a Musical","n":"Larry Gelbart","w":true},{"yr":44,"cat":"Best Original Score","n":"Cy Coleman","w":true},{"yr":44,"cat":"Best Original Score","n":"David Zippel","w":true},{"yr":44,"cat":"Best Actor in a Musical","n":"James Naughton","w":true},{"yr":44,"cat":"Best Featured Actress in a Musical","n":"Randy Graff","w":true},{"yr":44,"cat":"Best Scenic Design","n":"Robin Wagner","w":true},{"yr":44,"cat":"Best Book of a Musical","n":null,"w":true},{"yr":44,"cat":"Best Original Score","n":null,"w":true},{"yr":44,"cat":"Best Actor in a Musical","n":"Gregg Edelman"},{"yr":44,"cat":"Best Featured Actor in a Musical","n":"René Auberjonois"},{"yr":44,"cat":"Best Costume Design","n":"Florence Klotz"},{"yr":44,"cat":"Best Lighting Design","n":"Paul Gallo"},{"yr":44,"cat":"Best Direction of a Musical","n":"Michael Blakemore"}],"aw":{"s":90,"b":"sweeper","sub":"Won Best Musical + 5 more","sea":"1989-90","tw":6,"tn":10,"pz":null,"oth":[{"n":"Drama Desk","w":7,"nm":9},{"n":"Outer Critics","w":1,"nm":3}]},"cn":{"t":"Critics hail this old Hollywood musical as hilariously funny and brilliantly coordinated, with riotous jokes that stop the show and exhilarating performanc