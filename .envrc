# Load .env (API keys for scrapers, LLM providers, etc.)
export DIRENV_LOG_FORMAT=""
dotenv
# Unset ANTHROPIC_API_KEY so Claude Code uses claude.ai auth (not API key billing)
# Node scripts still load it directly from .env via dotenv package
unset ANTHROPIC_API_KEY

# Pin GitHub CLI to thomaspryor (personal) for this repo
export GH_TOKEN=$(gh auth token --user thomaspryor 2>/dev/null)
