{
  "name": "broadway-scorecard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "bash scripts/setup-git-hooks.sh 2>/dev/null || true",
    "prebuild": "bash scripts/prebuild.sh",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:design": "node scripts/lint-design-tokens.js",
    "test": "npm run test:data && npm run test:e2e",
    "test:data": "node scripts/validate-data.js && node scripts/validate-aggregator-truth.js",
    "audit:critics": "node scripts/audit-critic-outlets.js",
    "db:build": "node scripts/build-sqlite.js",
    "db:build:full": "node scripts/build-sqlite.js --include-text",
    "db:query": "node scripts/query.js",
    "test:aggregator": "node scripts/validate-aggregator-truth.js",
    "test:smoke": "npx playwright test --project=chromium tests/e2e/smoke.spec.ts",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:my-shows": "RUN_UGC_TESTS=1 TEST_BASE_URL=http://localhost:3456 npx playwright test tests/e2e/my-shows-mock.spec.ts",
    "test:functional": "RUN_UGC_TESTS=1 TEST_BASE_URL=http://localhost:3456 npx playwright test --project=chromium tests/e2e/my-shows-functional.spec.ts tests/e2e/show-rating-functional.spec.ts",
    "test:ugc": "RUN_UGC_TESTS=1 TEST_BASE_URL=http://localhost:3456 npx playwright test --project=chromium tests/e2e/my-shows-mock.spec.ts tests/e2e/my-shows-functional.spec.ts tests/e2e/show-rating-functional.spec.ts tests/e2e/ugc-visual-regression.spec.ts tests/e2e/ugc-visual-baselines.spec.ts",
    "test:unit": "node --test 'tests/unit/*.test.mjs' && npx tsx --test 'tests/unit/*.test.ts'",
    "data:check": "node scripts/check-data-health.js --fix",
    "deploy-now": "node scripts/deploy-now.js",
    "agent:update": "npx ts-node --project scripts/tsconfig.json scripts/agent-update.ts",
    "agent:report": "npx ts-node --project scripts/tsconfig.json scripts/agent-update.ts",
    "reviews:fetch": "npx ts-node --project scripts/tsconfig.json scripts/critic-reviews-agent/index.ts",
    "reviews:report": "npx ts-node --project scripts/tsconfig.json scripts/critic-reviews-agent/index.ts --report",
    "reviews:show": "npx ts-node --project scripts/tsconfig.json scripts/critic-reviews-agent/index.ts --show",
    "reviews:all": "npx ts-node --project scripts/tsconfig.json scripts/critic-reviews-agent/index.ts --all",
    "reviews:status": "npx ts-node --project scripts/tsconfig.json scripts/critic-reviews-agent/status.ts",
    "reviews:validate": "npx ts-node --project scripts/tsconfig.json scripts/critic-reviews-agent/validate.ts",
    "llm:score": "npx ts-node --project scripts/tsconfig.json scripts/llm-scoring/index.ts",
    "llm:score:show": "npx ts-node --project scripts/tsconfig.json scripts/llm-scoring/index.ts --show",
    "llm:score:all": "npx ts-node --project scripts/tsconfig.json scripts/llm-scoring/index.ts --all",
    "llm:ensemble": "npx ts-node --project scripts/tsconfig.json scripts/llm-scoring/index.ts --ensemble",
    "llm:calibrate": "npx ts-node --project scripts/tsconfig.json scripts/llm-scoring/index.ts --calibrate-only",
    "llm:validate": "npx ts-node --project scripts/tsconfig.json scripts/llm-scoring/index.ts --validate-only",
    "llm:ground-truth": "npx ts-node --project scripts/tsconfig.json scripts/llm-scoring/index.ts --ground-truth",
    "llm:evaluate": "npx ts-node --project scripts/tsconfig.json scripts/llm-scoring/evaluate.ts",
    "llm:status": "npx ts-node --project scripts/tsconfig.json scripts/llm-scoring/status.ts",
    "eval:theater-scorecard": "node scripts/evals/theater-scorecard-eval.js",
    "eval:theater-tips": "node scripts/evals/theater-tips-eval.js",
    "eval:buzz-classifier": "node scripts/evals/buzz-classifier-eval.js",
    "eval:content-verifier": "node scripts/evals/content-verifier-eval.js",
    "reviews:collect": "node scripts/collect-review-texts.js",
    "reviews:coverage": "node scripts/analyze-review-coverage.js",
    "consensus": "node scripts/generate-critic-consensus.js",
    "consensus:force": "node scripts/generate-critic-consensus.js --force",
    "grosses:alltime": "npx tsx scripts/scrape-alltime.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-analytics/data": "^5.2.2",
    "@google/generative-ai": "^0.24.1",
    "@notionhq/client": "^5.22.0",
    "@portabletext/react": "^3.2.4",
    "@portabletext/to-html": "^5.0.2",
    "@sanity/vision": "^3.99.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^1.6.1",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^1.3.1",
    "cheerio": "^1.2.0",
    "fuse.js": "^7.4.1",
    "next": "14.2.35",
    "next-sanity": "^9.12.3",
    "posthog-js": "^1.378.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "sanity": "^3.99.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.0",
    "axios": "^1.16.1",
    "better-sqlite3": "^11.10.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "gray-matter": "^4.0.3",
    "jsdom": "^27.4.0",
    "openai": "^6.41.0",
    "playwright": "^1.58.0",
    "playwright-extra": "^4.3.6",
    "postcss": "^8.5.15",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "twitter-api-v2": "^1.29.0",
    "typescript": "^5.4.5",
    "vercel": "^50.44.0"
  },
  "overrides": {
    "cheerio": {
      "undici": "^6.24.1"
    }
  }
}
